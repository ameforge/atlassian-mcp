{
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^26.6.6",
    "release-it": "^20.2.1",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "name": "atlassian-mcp",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "check": "biome check . && tsc --noEmit",
    "lint": "biome migrate --write && biome check --write . && tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks",
    "publish:atlassian": "pnpm -C packages/atlassian publish",
    "publish:bitbucket": "pnpm -C packages/bitbucket publish",
    "publish:conf": "pnpm -C packages/confluence publish",
    "publish:jira": "pnpm -C packages/jira publish",
    "release:all": "pnpm -C packages/jira release && pnpm -C packages/confluence release && pnpm -C packages/bitbucket release && pnpm release:atlassian",
    "release:atlassian": "pnpm -C packages/atlassian release",
    "release:bitbucket": "pnpm -C packages/bitbucket release && pnpm release:atlassian",
    "release:conf": "pnpm -C packages/confluence release && pnpm release:atlassian",
    "release:jira": "pnpm -C packages/jira release && pnpm release:atlassian",
    "test": "pnpm -r test",
    "update": "pnpm update -r"
  },
  "type": "module"
}
