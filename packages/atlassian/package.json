    "jira-server",
    "jira-data-center",
    "confluence",
    "confluence-server",
    "confluence-data-center",
    "bitbucket",
    "bitbucket-cloud",
    "self-hosted",
    "on-premise",
    "jql",
    "cql",
    "issue-tracking",
    "wiki",
    "pull-request",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "windsurf",
    "codex",
    "gemini",
    "ai",
    "ai-agent",
    "llm"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@ameforge/atlassian-mcp",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/atlassian",
