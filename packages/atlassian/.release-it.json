{
  "git": {
    "commit": true,
    "commitMessage": "chore(atlassian-mcp): release v${version}",
    "push": true,
    "pushTags": true,
    "requireCleanWorkingDir": true,
    "tag": true,
    "tagMatch": "atlassian-v*",
    "tagName": "atlassian-v${version}"
  },
  "github": {
    "release": false,
    "releaseName": "atlassian-mcp v${version}"
  },
  "hooks": {
    "before:init": ["pnpm -w run check", "pnpm test", "pnpm build"]
  },
  "npm": {
    "allowSameVersion": false,
    "publish": false
  },
  "only-version": true,
  "plugins": {
    "@release-it/conventional-changelog": {
      "commitsOpts": {
        "path": [".", "../jira", "../confluence", "../bitbucket"]
      },
      "gitRawCommitsOpts": {
        "path": [".", "../jira", "../confluence", "../bitbucket"]
      },
      "preset": {
        "name": "conventionalcommits"
      }
    }
  }
}
